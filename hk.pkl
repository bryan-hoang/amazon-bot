amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

// Both commands cover the whole project rather than the changed files: type
// checking and tests follow imports across files.
steps {
  ["vp-check"] {
    check = "pnpm exec vp check"
  }
  ["unit-tests"] {
    check = "pnpm exec vp test --project unit"
  }
}

hooks {
  // Check only: a commit never rewrites or stages files behind your back.
  ["pre-commit"] {
    fix = false
    stash = false
  }
  // The exe tests build the exe and launch Edge, which is too slow per commit.
  ["pre-push"] {
    steps {
      ["vp-check"] {
        check = "pnpm exec vp check"
      }
      ["all-tests"] {
        check = "pnpm exec vp test"
      }
    }
  }
}
