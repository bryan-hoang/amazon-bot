amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

local full = new Mapping<String, Step> {
  ["vp-check"] {
    check = "pnpm exec vp check"
  }
  ["all-tests"] {
    check = "pnpm exec vp test"
  }
  ["jactionlint"] = Builtins.jactionlint
}

steps = (full) {
  ["all-tests"] {
    profiles = List("slow")
  }
  ["unit-tests"] {
    check = "pnpm exec vp test --project unit"
    profiles = List("!slow")
  }
}

exclude = List("CHANGELOG.md")

hooks {
  // Check only: a commit never rewrites or stages files behind your back.
  ["pre-commit"] {
    fix = false
    stash = false
  }
  ["pre-push"] { steps = full }
  ["commit-msg"] {
    steps {
      ["check-conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
